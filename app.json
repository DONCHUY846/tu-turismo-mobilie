{
  "expo": {
    "name": "Tu Turismo",
    "slug": "tu-turismo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tuturismomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.donchuy846.tuturismomobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tu Turismo necesita tu ubicación para mostrarte en el mapa y encontrar lugares cerca de ti."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.donchuy846.tuturismomobile",
      "versionCode": 5,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/tutu-logo.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tu Turismo necesita acceso a tus fotos para que puedas elegir tu foto de perfil.",
          "cameraPermission": "Tu Turismo necesita la cámara para que puedas tomar tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
